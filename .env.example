# Live smoke-test credentials (copy to .env - gitignored - and fill in).
# `make smoke` sources .env when present. Never point this at a production
# account.
#
# The names are the ones the Fivetran Terraform provider reads, and the ones
# the stackql provider itself resolves.

# API key and secret (Fivetran dashboard -> user menu -> API Key), or the key
# and secret of a system key.
FIVETRAN_APIKEY=
FIVETRAN_APISECRET=
